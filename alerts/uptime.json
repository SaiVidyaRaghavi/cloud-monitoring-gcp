{
  "displayName": "VM Uptime Alert",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "VM stopped reporting uptime for 5 minutes",
      "conditionAbsent": {
        "filter": "resource.type = \"gce_instance\" AND metric.type = \"compute.googleapis.com/instance/uptime\"",
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_MEAN"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "documentation": {
    "mimeType": "text/markdown",
    "content": "The VM has stopped reporting. Check Compute Engine > VM instances and start it if stopped."
  },
  "notificationChannels": [
    "projects/PROJECT_ID/notificationChannels/CHANNEL_ID"
  ],
  "enabled": true
}